SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon/public key (REQUIRED). Used to verify user JWTs on every authenticated
# endpoint (app/core/auth.py). The API refuses to start when this is missing.
SUPABASE_KEY=your_anon_public_key_here

# Gemini API key (OPTIONAL). Powers the prediction synthesis layer. When absent
# the API still starts, but logs a WARNING and serves every prediction from the
# deterministic fallback summaries instead of Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Must match Settings.chart_engine_version in app/core/config.py.
CHART_ENGINE_VERSION=1.4.0
ENVIRONMENT=development
